@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix temi: <https://solve.corila.it/vocabolario/temi/> .

temi: a skos:ConceptScheme ;
    skos:prefLabel "Temi di SOLVe - Sistema Osservativo della Laguna di Venezia"@it ,
        "SOLVe themes - Venice Lagoon Observing System"@en ;
    dct:publisher "CORILA" ;
    skos:hasTopConcept temi:idrodinamica , temi:apporti , temi:colonna , temi:sedimenti , temi:habitat , temi:biologia , temi:clima , temi:usi , temi:base .

temi:idrodinamica a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Idrodinamica e scambi mare-laguna"@it , "Hydrodynamics and sea-lagoon exchanges"@en ;
    skos:definition "Maree, livelli, correnti, onde e scambi d'acqua alle bocche di porto."@it ;
    skos:topConceptOf temi: ;
    skos:narrower temi:idro-livello ;
    skos:narrower temi:idro-correnti ;
    skos:narrower temi:idro-onde ;
    skos:narrower temi:idro-opere .

temi:idro-livello a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Livello del mare e maree"@it , "Sea level and tides"@en ;
    skos:definition "Misure di livello e marea: reti mareografiche (RMN, RMLV, ICPSM)."@it ;
    skos:broader temi:idrodinamica ;
    skos:related temi:clima-scenari ;
    skos:related temi:idro-opere ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/ASLV/> .

temi:idro-correnti a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Correnti e portate alle bocche"@it , "Currents and inlet fluxes"@en ;
    skos:definition "Velocità delle correnti e portate di scambio mare-laguna (ADCP, bocche di porto)."@it ;
    skos:broader temi:idrodinamica ;
    skos:related temi:sedimenti-dinamica ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/RFVL/> .

temi:idro-onde a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Onde"@it , "Waves"@en ;
    skos:definition "Altezza, periodo e direzione del moto ondoso."@it ;
    skos:broader temi:idrodinamica ;
    skos:related temi:clima-meteo ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/WVST/> .

temi:idro-opere a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Opere alle bocche e MOSE"@it , "Inlet works and MOSE"@en ;
    skos:definition "Strutture alle bocche di porto e funzionamento del sistema MOSE."@it ;
    skos:broader temi:idrodinamica ;
    skos:related temi:idro-livello ;
    skos:closeMatch <http://vocab.nerc.ac.uk/collection/P03/current/H002/> ;
    skos:broadMatch <http://inspire.ec.europa.eu/theme/us> ;
    skos:editorialNote "Nessun parametro P02: aggancio manuale al gruppo e al tema INSPIRE"@it .

temi:apporti a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Apporti e pressioni"@it , "Inputs and pressures"@en ;
    skos:definition "Ciò che arriva in laguna dal bacino scolante, dall'atmosfera e dalle attività: acque dolci, carichi, deposizioni, rumore."@it ;
    skos:topConceptOf temi: ;
    skos:narrower temi:apporti-fiumi ;
    skos:narrower temi:apporti-carichi ;
    skos:narrower temi:apporti-falda ;
    skos:narrower temi:apporti-aria ;
    skos:narrower temi:apporti-rumore ;
    skos:editorialNote "Include aria e rumore dei cantieri (da confermare)"@it .

temi:apporti-fiumi a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Fiumi e portate"@it , "Rivers and discharges"@en ;
    skos:definition "Portate e livelli dei corsi d'acqua del bacino scolante e dei fiumi (es. Livenza)."@it ;
    skos:broader temi:apporti ;
    skos:related temi:apporti-carichi ;
    skos:related temi:apporti-falda ;
    skos:related temi:base-idrografia ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/RVDS/> ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/LRWL/> .

temi:apporti-carichi a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Carichi dal bacino scolante"@it , "Catchment loads"@en ;
    skos:definition "Carichi di nutrienti e contaminanti trasportati dal bacino scolante verso la laguna."@it ;
    skos:broader temi:apporti ;
    skos:related temi:apporti-fiumi ;
    skos:related temi:colonna-nutrienti ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/CFTM/> .

temi:apporti-falda a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Acque sotterranee e cuneo salino"@it , "Groundwater and saltwater intrusion"@en ;
    skos:definition "Livello e qualità della falda, risalita del cuneo salino."@it ;
    skos:broader temi:apporti ;
    skos:related temi:apporti-fiumi ;
    skos:related temi:habitat-vegetazione ;
    skos:broadMatch <http://inspire.ec.europa.eu/theme/ge> ;
    skos:broadMatch <http://inspire.ec.europa.eu/theme/hy> ;
    skos:editorialNote "SeaDataNet non copre le acque sotterranee: solo temi INSPIRE"@it .

temi:apporti-aria a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Qualità dell'aria e deposizioni"@it , "Air quality and atmospheric deposition"@en ;
    skos:definition "Polveri (PM10), IPA, metalli e deposizioni atmosferiche."@it ;
    skos:broader temi:apporti ;
    skos:related temi:clima-meteo ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/ATDP/> ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/> ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/GP050/> .

temi:apporti-rumore a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Rumore"@it , "Noise"@en ;
    skos:definition "Rumore aereo e subacqueo legato a cantieri e traffico."@it ;
    skos:broader temi:apporti ;
    skos:narrowMatch <http://vocab.nerc.ac.uk/collection/P02/current/NOYS/> ;
    skos:broadMatch <http://inspire.ec.europa.eu/theme/hh> ;
    skos:editorialNote "NOYS copre solo il rumore subacqueo; per il rumore aereo tema INSPIRE hh"@it .

temi:colonna a skos:Concept ;
    skos:inScheme temi: ;
    skos:prefLabel "Colonna d'acqua"@it , "Water column"@en ;
    skos:definition "Proprietà fisiche, chimiche e biologiche dell'acqua lagunare e costiera."@it ;
